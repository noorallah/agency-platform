# Application
AGENCY_APP_NAME=Agency Platform Backend
# No AGENCY_APP_VERSION: the version is the build's (settings.py), and a
# value here overrides it -- /health and `agency-server where` reported 0.1.0.
AGENCY_ENVIRONMENT=development
AGENCY_DEBUG=false
AGENCY_LOG_LEVEL=INFO
# One folder for every log. The server writes to its `server` subfolder:
# server-YYYY-MM-DD.log (everything) and errors-YYYY-MM-DD.log (WARNING and
# above), a new file each midnight. The installer sets this to
# C:\ProgramData\Agency Platform\logs.
AGENCY_LOG_DIRECTORY=logs
# A day's file is rolled over to server-YYYY-MM-DD.1.log, .2.log ... when it
# reaches this size (bytes). 52428800 = 50 MB.
AGENCY_LOG_MAX_BYTES=52428800
AGENCY_LOG_FILE_ENABLED=true
# Days a server log is kept, and days an error log is kept. Files from before
# yesterday are gzipped. Cleanup runs at startup, hourly, and in
# `agency-server purge-retention --yes`.
AGENCY_LOG_RETENTION_DAYS=30
AGENCY_LOG_ERROR_RETENTION_DAYS=90
# Cap on everything under AGENCY_LOG_DIRECTORY, in MB; the oldest files are
# deleted first once it is passed. Today's two open files are never deleted.
AGENCY_LOG_MAX_TOTAL_MB=1024
# Retired, still accepted: AGENCY_LOG_FILE_NAME and AGENCY_LOG_BACKUP_COUNT
# named the single rotating file this replaced, and are ignored now.

# Database
# DATABASE_URL overrides the individual connection settings when supplied.
# AGENCY_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agency_platform
AGENCY_DATABASE_DIALECT=postgresql
AGENCY_DATABASE_HOST=localhost
# AGENCY_DATABASE_PORT=5432
AGENCY_DATABASE_NAME=agency_platform
AGENCY_DATABASE_USERNAME=postgres
AGENCY_DATABASE_PASSWORD=postgres
AGENCY_DATABASE_POOL_SIZE=5
AGENCY_DATABASE_MAX_OVERFLOW=10
AGENCY_DATABASE_POOL_RECYCLE_SECONDS=1800
AGENCY_DATABASE_SCHEMA=platform

# Identity & Security
# Set a unique, high-entropy value in every non-development environment.
AGENCY_JWT_SECRET_KEY=development-only-change-this-secret-key-before-production
AGENCY_JWT_ALGORITHM=HS256
AGENCY_JWT_ACCESS_TOKEN_MINUTES=15
AGENCY_JWT_REFRESH_TOKEN_DAYS=7
AGENCY_SECURITY_MAX_LOGIN_ATTEMPTS=5
AGENCY_SECURITY_LOCKOUT_MINUTES=15
AGENCY_SECURITY_PASSWORD_HISTORY_COUNT=5
# Development only: used once to initialize the seeded platform administrator.
# Staging and production must set this to a unique secret through their secret store.
AGENCY_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Licensing
AGENCY_LICENSE_ENABLED=false
# AGENCY_LICENSE_VALIDATION_URL=

# Tenancy / Installer
# SHARED = shared database + shared schema
# SCHEMA = shared database + dedicated schema per firm
# DATABASE = dedicated database per firm
AGENCY_TENANCY_SHARED_DATABASE_NAME=agency_platform
AGENCY_TENANCY_SHARED_SCHEMA_NAME=firm_shared
# Global prefix applied to default shared and dedicated schema names.
# Example: AGENCY_TENANCY_SCHEMA_PREFIX=erp_
AGENCY_TENANCY_SCHEMA_PREFIX=
AGENCY_TENANCY_DEDICATED_SCHEMA_PREFIX=firm_
AGENCY_TENANCY_DEDICATED_DATABASE_PREFIX=erp_
# Optional JSON map naming the servers firm storage can live on.
# Keys are profile names (for example REMOTE_A), matched case-insensitively
# against firm_storage_mappings.connection_profile. A firm with no profile uses
# the platform server and AGENCY_DATABASE_USERNAME/PASSWORD.
# A name a firm references but this map does not define is refused at firm
# creation, so a typo cannot produce a firm that serves nothing.
# Each profile database_type must match AGENCY_DATABASE_DIALECT.
# AGENCY_TENANCY_CONNECTION_PROFILES={"REMOTE_A":{"username":"tenant_user","password":"tenant_password","database_host":"10.0.0.25","database_port":5432,"database_type":"postgresql"}}
# To try one locally: `docker compose up -d postgres-tenant` starts a second
# server with its own user and password on host port 5433; uncomment the line
# below to point REMOTE_A at it. Use it when the backend runs on the machine rather than in the
# stack -- inside the stack docker-compose.yml sets the same profile with host
# `postgres-tenant` and port 5432, and that value wins over this file.
# It stays commented here because this file is also the installer's template:
# live, it gave every customer a REMOTE_A profile with the password CHANGE_ME.
# AGENCY_TENANCY_CONNECTION_PROFILES={"REMOTE_A":{"username":"tenant_admin","password":"CHANGE_ME","database_host":"127.0.0.1","database_port":5433,"database_type":"postgresql"}}
# Optional slot-based profiles for dedicated databases (alternative to JSON):
# AGENCY_DATABASE1_HOST=10.0.0.25
# AGENCY_DATABASE1_PORT=5432
# AGENCY_DATABASE1_TYPE=postgresql
# AGENCY_DATABASE1_USERNAME=tenant_user
# AGENCY_DATABASE1_PASSWORD=tenant_password
